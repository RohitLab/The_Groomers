# ─── The Groomers Salon CRM — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your real values.
# ⚠️  NEVER commit .env to Git — it contains production secrets.
# ✅  This .env.example is SAFE to commit — no real values inside.
# ─────────────────────────────────────────────────────────────────────────────

# Dashboard PIN — 4 digits, only you need to know this
# ⚠️  CHANGE THIS from the default — use something like 7391, not 1234
DASHBOARD_PIN=change-me-to-your-4-digit-pin

# Google Sheets ID (from the spreadsheet URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEETS_ID=your-google-sheets-id

# Google Service Account credentials (paste entire JSON on one line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com"}

# Gemini API Key (from aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude API Key (from console.anthropic.com)
# ⚠️  Must be named ANTHROPIC_API_KEY (not ANTHROPIC_KEY)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Resend Email Service (from resend.com → API Keys)
RESEND_API_KEY=re_your-resend-key-here
RESEND_FROM_EMAIL=bookings@yourdomain.com

# API URL for frontend (leave empty for dev proxy)
VITE_API_URL=

# ─── Google Contacts Integration (OAuth2) ────────────────────────────────────
# Required to auto-save new customers to owner's personal Google Contacts.
# Setup: Dashboard → Settings → Connect Google Contacts → follow steps shown.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=https://thegroomers.shop/api/auth/callback

# Step: Visit /api/auth/authorize → complete OAuth → click Copy Token
GOOGLE_REFRESH_TOKEN=your-refresh-token-from-oauth-callback
